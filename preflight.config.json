{
  "project": "helpdesk-copilot",
  "target": {
    "name": "app",
    "baseUrl": "http://127.0.0.1:4300",
    "environment": "preview",
    "allowCommandAdapter": false
  },
  "suites": {
    "helpdesk-copilot": [
      ".preflight/suites/**/*.json"
    ],
    "preflight-capabilities": [
      ".preflight/probe/*.json"
    ],
    "preflight-auth": [
      ".preflight/probe-auth/*.json"
    ]
  },
  "prompts": {
    "refund-triage": [
      "prompts/triage.md"
    ],
    "reply-drafting": [
      "prompts/replies.md"
    ],
    "thread-summaries": [
      "prompts/summaries.md"
    ],
    "help-center-answers": [
      "prompts/answers.md",
      "kb/*.md"
    ],
    "tag-incoming-tickets-by-product-area": [
      "prompts/tags.md"
    ],
    "reply-quality-reviews": [
      "prompts/reviews.md"
    ]
  },
  "upload": {
    "enabled": true,
    "apiBaseUrl": "http://127.0.0.1:4100",
    "apiKeyEnv": "PREFLIGHT_API_KEY",
    "visibleInOutput": true
  },
  "reports": {
    "outputDir": "preflight-reports",
    "format": "json"
  },
  "scenarios": {
    "missingTemplateValuePolicy": "error"
  }
}
