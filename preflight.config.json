{
  "project": "helpdesk-copilot",
  "target": {
    "name": "app",
    "baseUrl": "http://127.0.0.1:4300",
    "environment": "preview",
    "allowCommandAdapter": false
  },
  "suites": {
    "helpdesk-copilot": [
      ".preflight/suites/**/*.json"
    ],
    "preflight-capabilities": [
      ".preflight/probe/*.json"
    ],
    "preflight-auth": [
      ".preflight/probe-auth/*.json"
    ]
  },
  "featureFiles": {
    "refund-triage": [
      "app/features/triage.mjs",
      "prompts/triage.md",
      "app/lib/model.mjs",
      "app/lib/pii.mjs",
      "app/server.mjs",
      "config/models.json"
    ],
    "reply-drafting": [
      "app/features/replies.mjs",
      "prompts/replies.md",
      "app/lib/orders.mjs",
      "data/orders.json",
      "data/customers.json",
      "app/lib/model.mjs",
      "app/lib/pii.mjs",
      "app/server.mjs",
      "config/models.json"
    ],
    "thread-summaries": [
      "app/features/summaries.mjs",
      "prompts/summaries.md",
      "app/lib/model.mjs",
      "app/lib/pii.mjs",
      "app/server.mjs",
      "config/models.json"
    ],
    "help-center-answers": [
      "app/features/answers.mjs",
      "prompts/answers.md",
      "app/lib/kb.mjs",
      "kb/*.md",
      "app/lib/model.mjs",
      "app/lib/pii.mjs",
      "app/server.mjs",
      "config/models.json"
    ],
    "tag-incoming-tickets-by-product-area": [
      "app/features/tags.mjs",
      "prompts/tags.md",
      "app/lib/model.mjs",
      "app/lib/pii.mjs",
      "app/server.mjs",
      "config/models.json"
    ],
    "reply-quality-reviews": [
      "app/features/reviews.mjs",
      "prompts/reviews.md",
      "app/lib/model.mjs",
      "app/lib/pii.mjs",
      "app/server.mjs",
      "config/models.json"
    ]
  },
  "upload": {
    "enabled": true,
    "apiBaseUrl": "http://127.0.0.1:4100",
    "apiKeyEnv": "PREFLIGHT_API_KEY",
    "visibleInOutput": true
  },
  "reports": {
    "outputDir": "preflight-reports",
    "format": "json"
  },
  "scenarios": {
    "missingTemplateValuePolicy": "error"
  },
  "nonAppFiles": [
    "README.md",
    "policies/refund-policy.md",
    ".github/**",
    ".gitignore",
    "test/**"
  ]
}
